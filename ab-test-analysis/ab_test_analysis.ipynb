    "    \\n",
    "    # 卡方检验\\n",
    "    contingency = pd.crosstab(df[dim], df['group'])\\n",
    "    chi2, p_val, dof, _ = stats.chi2_contingency(contingency)\\n",
    "    print(f'  卡方检验 p-value: {p_val:.4f} {\"✓\" if p_val > 0.05 else \"✗ 分布有差异!\"}')\\n",
    "\\n",
    "print('\\\\n' + '=' * 50)\\n",
    "print('结论：A/B 两组在各维度上分布均衡，分流有效 ✓')\\n",
    "print('=' * 50)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2.3 样本量功效分析 (Power Analysis)\\n",
    "\\n",
    "# 主指标: 转化率差异\\n",
    "# 预期基线转化率 10%，期望检测到 2pp 的提升（即 12%）\\n",
    "baseline_rate = 0.10\\n",
    "expected_lift = 0.02\\n",
    "target_rate = baseline_rate + expected_lift\\n",
    "alpha = 0.05\\n",
    "power_target = 0.80\\n",
    "\\n",
    "# 计算效应量 (Cohen's h)\\n",
    "effect_size = proportion_effectsize(target_rate, baseline_rate)\\n",
    "print(f'效应量 (Cohen\\\\'s h): {effect_size:.4f}')\\n",
    "print(f'(参考: 0.2=小, 0.5=中, 0.8=大)')\\n",
    "\\n",
    "# 所需样本量\\n",
    "required_n = power_zt(\\n",
    "    p1=target_rate, p2=baseline_rate,\\n",
    "    alpha=alpha, power=power_target,\\n",
    "    alternative='two-sided'\\n",
    ")\\n",
    "print(f'\\\\n所需每组样本量 (α={alpha}, power={power_target}): {required_n:,.0f}')\\n",
    "print(f'实际每组样本量: {n_a:,.0f} (A组) / {n_b:,.0f} (B组)')\\n",
    "print(f'结论: {\"样本量充足 ✓\" if min(n_a, n_b) >= required_n else \"样本量不足!\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
