    "import numpy as np\\n",
    "import matplotlib.pyplot as plt\\n",
    "import seaborn as sns\\n",
    "from scipy import stats\\n",
    "from statsmodels.stats.proportion import proportions_ztest, power_zt, proportion_effectsize\\n",
    "from statsmodels.stats.power import TTestIndPower\\n",
    "import warnings\\n",
    "warnings.filterwarnings('ignore')\\n",
    "\\n",
    "# 中文显示设置\\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei', 'Microsoft YaHei', 'PingFang SC']\\n",
    "plt.rcParams['axes.unicode_minus'] = False\\n",
    "\\n",
    "# 绘图风格\\n",
    "sns.set_style('whitegrid')\\n",
    "sns.set_palette('Set2')\\n",
    "\\n",
    "print('环境就绪 ✓')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 加载数据\\n",
    "df = pd.read_csv('data/ab_test_data.csv')\\n",
    "print(f'数据集: {len(df):,} 行 × {len(df.columns)} 列')\\n",
    "df.head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 数据验证 (Data Validation)\\n",
    "\\n",
    "在正式分析之前，必须先验证实验数据的质量：\\n",
    "1. **分流均匀性 (Randomization Check)**：A/B 两组用户在各维度上是否分布均衡\\n",
    "2. **样本量充足性**：样本量是否足够检测到预期效应\\n",
    "3. **数据完整性**：是否存在异常值或数据缺失"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2.1 分流均匀性检查\\n",
    "print('=' * 50)\\n",
    "print('分流均匀性检查')\\n",
    "print('=' * 50)\\n",
    "\\n",
    "# 组间样本量\\n",
    "n_a = (df['group'] == 'A').sum()\\n",
    "n_b = (df['group'] == 'B').sum()\\n",
    "print(f'\\\\nA 组: {n_a:,} 用户 ({n_a/len(df)*100:.1f}%)')\\n",
    "print(f'B 组: {n_b:,} 用户 ({n_b/len(df)*100:.1f}%)')\\n",
    "\\n",
    "# 卡方检验：分配比例是否与 50:50 有显著差异\\n",
    "from scipy.stats import chisquare\\n",
    "chi2, p_chi2 = chisquare([n_a, n_b])\\n",
    "print(f'\\\\n卡方检验 p-value: {p_chi2:.4f}')\\n",
    "print(f'结论: {\"分流均匀 ✓\" if p_chi2 > 0.05 else \"分流不均衡! ✗\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2.2 按维度的分布检查\\n",
    "print('\\\\n各维度的 A/B 组分布对比:')\\n",
    "print('-' * 50)\\n",
    "\\n",
    "for dim in ['membership_level', 'device_type']:\\n",
    "    cross_tab = pd.crosstab(df[dim], df['group'], normalize='columns')\\n",
    "    print(f'\\\\n【{dim}】')\\n",
