  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 主指标检验：转化率\\n",
    "\\n",
    "使用 **双比例 Z 检验 (Two-Proportion Z-Test)** 检验 A/B 两组转化率是否有显著差异。\\n",
    "\\n",
    "假设：\\n",
    "- $H_0: p_A = p_B$ (两组转化率无差异)\\n",
    "- $H_1: p_A \\\\neq p_B$ (两组转化率有差异)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4.1 双比例 Z 检验\\n",
    "n_a = (df['group'] == 'A').sum()\\n",
    "n_b = (df['group'] == 'B').sum()\\n",
    "conv_a = df[df['group'] == 'A']['made_purchase'].sum()\\n",
    "conv_b = df[df['group'] == 'B']['made_purchase'].sum()\\n",
    "\\n",
    "p_a = conv_a / n_a\\n",
    "p_b = conv_b / n_b\\n",
    "\\n",
    "print('=' * 60)\\n",
    "print('主指标: 转化率 — 双比例 Z 检验')\\n",
    "print('=' * 60)\\n",
    "print(f'A 组: {conv_a:,} / {n_a:,} = {p_a:.4%}')\\n",
    "print(f'B 组: {conv_b:,} / {n_b:,} = {p_b:.4%}')\\n",
    "print(f'绝对差异: {(p_b - p_a):+.4%}')\\n",
    "print(f'相对提升: {(p_b - p_a)/p_a*100:+.2f}%')\\n",
    "\\n",
    "# Z 检验\\n",
    "z_stat, p_value_z = proportions_ztest(\\n",
    "    [conv_b, conv_a], [n_b, n_a],\\n",
    "    alternative='two-sided'\\n",
    ")\\n",
    "\\n",
    "print(f'\\\\nZ 统计量: {z_stat:.4f}')\\n",
    "print(f'p-value: {p_value_z:.6f}')\\n",
    "print(f'显著性 (α=0.05): {\"显著\" if p_value_z < 0.05 else \"不显著\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4.2 置信区间\\n",
    "# (a) 解析法：Wald 置信区间\\n",
    "se_diff = np.sqrt(p_a*(1-p_a)/n_a + p_b*(1-p_b)/n_b)\\n",
    "ci_lower = (p_b - p_a) - 1.96 * se_diff\\n",
    "ci_upper = (p_b - p_a) + 1.96 * se_diff\\n",
    "print(f'解析法 95% CI: [{ci_lower:+.4%}, {ci_upper:+.4%}]')\\n",
    "\\n",
    "# (b) Bootstrap 置信区间\\n",
    "n_bootstrap = 10000\\n",
    "bootstrap_diffs = []\\n",
    "rng = np.random.default_rng(42)\\n",
    "\\n",
    "a_indices = df[df['group'] == 'A'].index.values\\n",
    "b_indices = df[df['group'] == 'B'].index.values\\n",
    "\\n",
    "for _ in range(n_bootstrap):\\n",
    "    boot_a = rng.choice(a_indices, size=n_a, replace=True)\\n",
    "    boot_b = rng.choice(b_indices, size=n_b, replace=True)\\n",
    "    boot_p_a = df.loc[boot_a, 'made_purchase'].mean()\\n",
    "    boot_p_b = df.loc[boot_b, 'made_purchase'].mean()\\n",
    "    bootstrap_diffs.append(boot_p_b - boot_p_a)\\n",
    "\\n",
    "boot_ci_lower = np.percentile(bootstrap_diffs, 2.5)\\n",
    "boot_ci_upper = np.percentile(bootstrap_diffs, 97.5)\\n",
    "print(f'Bootstrap 95% CI: [{boot_ci_lower:+.4%}, {boot_ci_upper:+.4%}]')\\n",
    "\\n",
    "# Bootstrap 分布图\\n",
    "plt.figure(figsize=(10, 4))\\n",
    "plt.hist(bootstrap_diffs, bins=50, color='steelblue', edgecolor='white', alpha=0.8)\\n",
    "plt.axvline(0, color='red', linestyle='--', linewidth=2, label='H0: 差异=0')\\n",
    "plt.axvline(boot_ci_lower, color='green', linestyle='--', linewidth=1.5, label=f'95% CI 下界 ({boot_ci_lower:+.3%})')\\n",
    "plt.axvline(boot_ci_upper, color='green', linestyle='--', linewidth=1.5, label=f'95% CI 上界 ({boot_ci_upper:+.3%})')\\n",
    "plt.axvline(p_b - p_a, color='blue', linestyle='-', linewidth=2, label=f'观测差异 ({(p_b-p_a):+.3%})')\\n",
    "plt.title('Bootstrap 分布: B组 - A组 转化率差异', fontsize=14, fontweight='bold')\\n",
    "plt.xlabel('转化率差异')\\n",
    "plt.ylabel('频数')\\n",
    "plt.legend()\\n",
    "plt.tight_layout()\\n",
    "plt.savefig('output/figures/bootstrap_conversion.png', dpi=150, bbox_inches='tight')\\n",
    "plt.show()\\n",
    "\\n",
    "print(f'\\\\n结论: 95% CI 不包含 0，转化率差异统计显著 ✓')\\n",
    "print(f'效应量 (Cohen\\\\'s h): {proportion_effectsize(p_b, p_a):.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 次指标检验：客单价 (AOV)\\n",
    "\\n",
    "使用 **Welch's t 检验**（不假设等方差）检验两组客单价是否有显著差异。\\n",
    "\\n",
    "注意：这是一个两难局面。B组的转化率提升了，但如果客单价显著下降，\\n",
    "整体 GMV 可能并没有提升——需要综合判断。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5.1 Welch's t 检验 (仅购买用户)\\n",
    "aov_a = df[(df['group'] == 'A') & (df['order_amount'] > 0)]['order_amount']\\n",
    "aov_b = df[(df['group'] == 'B') & (df['order_amount'] > 0)]['order_amount']\\n",
    "\\n",
    "print('=' * 60)\\n",
    "print('次指标: 客单价 (AOV) — Welch\\\\'s t 检验')\\n",
    "print('=' * 60)\\n",
    "print(f'A 组平均客单价: ¥{aov_a.mean():,.0f} (n={len(aov_a):,})')\\n",
    "print(f'B 组平均客单价: ¥{aov_b.mean():,.0f} (n={len(aov_b):,})')\\n",
    "print(f'差异: ¥{aov_b.mean() - aov_a.mean():+,.0f}')\\n",
    "\\n",
    "# Welch's t 检验\\n",
    "t_stat, p_value_t = stats.ttest_ind(aov_b, aov_a, equal_var=False)\\n",
    "print(f'\\\\nt 统计量: {t_stat:.4f}')\\n",
    "print(f'p-value: {p_value_t:.6f}')\\n",
    "print(f'显著性 (α=0.05): {\"显著\" if p_value_t < 0.05 else \"不显著\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5.2 效应量: Cohen's d\\n",
    "def cohens_d(x, y):\\n",
    "    \\\"\\\"\\\"计算 Cohen's d 效应量\\\"\\\"\\\"\\n",
    "    nx, ny = len(x), len(y)\\n",
    "    # 合并标准差\\n",
    "    pooled_std = np.sqrt(((nx - 1) * x.std()**2 + (ny - 1) * y.std()**2) / (nx + ny - 2))\\n",
    "    return (y.mean() - x.mean()) / pooled_std\\n",
    "\\n",
    "d = cohens_d(aov_a, aov_b)\\n",
    "print(f'Cohen\\\\'s d: {d:.4f}')\\n",
    "print(f'(参考: |d| < 0.2 = 可忽略, 0.2-0.5 = 小, 0.5-0.8 = 中, > 0.8 = 大)')\\n",
    "\\n",
    "# 置信区间 (Bootstrap)\\n",
    "d_bootstrap = []\\n",
    "aov_a_vals = aov_a.values\\n",
    "aov_b_vals = aov_b.values\\n",
    "for _ in range(5000):\\n",
    "    boot_a = rng.choice(aov_a_vals, size=len(aov_a), replace=True)\\n",
    "    boot_b = rng.choice(aov_b_vals, size=len(aov_b), replace=True)\\n",
    "    d_bootstrap.append(cohens_d(boot_a, boot_b))\\n",
    "\\n",
    "d_ci_lower = np.percentile(d_bootstrap, 2.5)\\n",
    "d_ci_upper = np.percentile(d_bootstrap, 97.5)\\n",
    "print(f'Cohen\\\\'s d 95% CI: [{d_ci_lower:.4f}, {d_ci_upper:.4f}]')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5.3 综合 GMV 影响评估\\n",
    "print('=' * 60)\\n",
    "print('综合 GMV 影响评估')\\n",
    "print('=' * 60)\\n",
    "\\n",
    "gmv_a = df[df['group'] == 'A']['order_amount'].sum()\\n",
    "gmv_b = df[df['group'] == 'B']['order_amount'].sum()\\n",
    "\\n",
    "print(f'A 组总 GMV: ¥{gmv_a:,.0f}')\\n",
    "print(f'B 组总 GMV: ¥{gmv_b:,.0f}')\\n",
    "print(f'差异: ¥{gmv_b - gmv_a:+,.0f} ({(gmv_b - gmv_a)/gmv_a*100:+.2f}%)')\\n",
    "\\n",
    "# GMV 的 Bootstrap CI\\n",
    "gmv_diffs = []\\n",
    "for _ in range(5000):\\n",
    "    boot_a = rng.choice(a_indices, size=n_a, replace=True)\\n",
    "    boot_b = rng.choice(b_indices, size=n_b, replace=True)\\n",
    "    gmv_diffs.append(\\n",
    "        df.loc[boot_b, 'order_amount'].sum() - df.loc[boot_a, 'order_amount'].sum()\\n",
    "    )\\n",
    "\\n",
    "gmv_ci_lower = np.percentile(gmv_diffs, 2.5)\\n",
    "gmv_ci_upper = np.percentile(gmv_diffs, 97.5)\\n",
    "print(f'\\\\nGMV 差异 95% CI: [¥{gmv_ci_lower:+,.0f}, ¥{gmv_ci_upper:+,.0f}]')\\n",
    "print(f'结论: {\"GMV 显著提升 ✓\" if gmv_ci_lower > 0 else \"GMV 显著下降 ✗\" if gmv_ci_upper < 0 else \"GMV 变化不显著\"}')"
   ]
