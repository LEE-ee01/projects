   "source": [
    "# 6.1 按会员等级分层\\n",
    "print('=' * 60)\\n",
    "print('分层分析: 按会员等级')\\n",
    "print('=' * 60)\\n",
    "\\n",
    "membership_order = ['普通会员', '银卡会员', '金卡会员', '钻石会员', '黑金会员']\\n",
    "seg_results = []\\n",
    "\\n",
    "for level in membership_order:\\n",
    "    subset = df[df['membership_level'] == level]\\n",
    "    n_a_sub = (subset['group'] == 'A').sum()\\n",
    "    n_b_sub = (subset['group'] == 'B').sum()\\n",
    "    \\n",
    "    if n_a_sub < 30 or n_b_sub < 30:\\n",
    "        continue\\n",
    "    \\n",
    "    conv_a_sub = subset[subset['group'] == 'A']['made_purchase'].mean()\\n",
    "    conv_b_sub = subset[subset['group'] == 'B']['made_purchase'].mean()\\n",
    "    diff = conv_b_sub - conv_a_sub\\n",
    "    \\n",
    "    # 分层 Z 检验\\n",
    "    conv_a_n = subset[subset['group'] == 'A']['made_purchase'].sum()\\n",
    "    conv_b_n = subset[subset['group'] == 'B']['made_purchase'].sum()\\n",
    "    _, p_val = proportions_ztest([conv_b_n, conv_a_n], [n_b_sub, n_a_sub])\\n",
    "    \\n",
    "    seg_results.append({\\n",
    "        'membership_level': level,\\n",
    "        'n_A': n_a_sub, 'n_B': n_b_sub,\\n",
    "        'conv_A': conv_a_sub, 'conv_B': conv_b_sub,\\n",
    "        'diff': diff, 'p_value': p_val,\\n",
    "        'significant': p_val < 0.05\\n",
    "    })\\n",
    "    \\n",
    "    print(f'{level}: A={conv_a_sub:.2%}, B={conv_b_sub:.2%}, '\\n",
    "          f'差异={diff:+.2%}, p={p_val:.4f} {\"*\" if p_val < 0.05 else \"\"}')\\n",
    "\\n",
    "# 多重比较校正 (Bonferroni)\\n",
    "n_tests = len(seg_results)\\n",
    "alpha_corrected = 0.05 / n_tests\\n",
    "print(f'\\\\nBonferroni 校正后 α = 0.05/{n_tests} = {alpha_corrected:.4f}')\\n",
    "for r in seg_results:\\n",
    "    r['bonferroni_sig'] = r['p_value'] < alpha_corrected\\n",
    "    if r['bonferroni_sig']:\\n",
    "        print(f'{r[\"membership_level\"]}: 校正后仍显著 ✓')\\n",
    "    elif r['significant']:\\n",
    "        print(f'{r[\"membership_level\"]}: 校正后不显著 (名义显著)')\\n",
    "    else:\\n",
    "        print(f'{r[\"membership_level\"]}: 不显著')"
   ]
